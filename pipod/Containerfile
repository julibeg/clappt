ARG PLAYWRIGHT_VERSION=1.63.0
ARG UV_VERSION=0.12.17
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble

ARG PLAYWRIGHT_VERSION
# npm measures minimum release age in days; pnpm measures it in minutes.
# Having an env var for both is the least annoying option, despite the duplication.
# Keep package pins at least MINIMUM_RELEASE_AGE_DAYS old when updating them.
# Also, make sure days and minutes match (otherwise RUN guard below will trigger)
ARG PNPM_VERSION=12.6.0
ARG MINIMUM_RELEASE_AGE_DAYS=2
ARG MINIMUM_RELEASE_AGE_MINUTES=2880
ARG FIRECRAWL_VERSION=1.24.4
ARG T3_VERSION=0.0.40
ARG FD_VERSION=10.5.0
ARG PYTHON_VERSION=3.13.14
ARG RIPGREP_VERSION=15.2.0
ARG RUFF_VERSION=0.16.8
ARG PIXI_VERSION=0.81.0

RUN test "$((MINIMUM_RELEASE_AGE_DAYS * 1440))" -eq "$MINIMUM_RELEASE_AGE_MINUTES" \
    || { echo "ERROR: release age values do not match" >&2; exit 1; }

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential ca-certificates curl git imagemagick jq less \
        poppler-utils procps shellcheck vim \
    && rm -rf /var/lib/apt/lists/*

# The Playwright image already contains an unprivileged `pwuser` and browsers.
RUN test "$(id -u pwuser):$(id -g pwuser)" = 1001:1001 \
    && usermod --login user --home /home/user --move-home pwuser \
    && groupmod --new-name user pwuser \
    && install -d -o user -g user /opt/uv-project-environment \
    && echo 'export PATH="/home/user/.cargo/bin:$PATH"' \
        >/etc/profile.d/pipod-path.sh

ENV HOME=/home/user \
    USER=user \
    LOGNAME=user \
    MPLCONFIGDIR=/home/user/.cache/matplotlib \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/uv-project-environment \
    SHELL=/bin/bash \
    PATH=/home/user/.cargo/bin:/home/user/.local/bin:/home/user/.pixi/bin:/usr/local/share/pnpm/bin:/usr/local/bin:/usr/bin:/bin \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    DISABLE_AUTOUPDATER=1 \
    NPM_CONFIG_MIN_RELEASE_AGE=$MINIMUM_RELEASE_AGE_DAYS \
    PNPM_CONFIG_MINIMUM_RELEASE_AGE=$MINIMUM_RELEASE_AGE_MINUTES

COPY --from=uv /uv /usr/local/bin/uv

RUN curl -fsSL https://pixi.sh/install.sh \
    | env PIXI_VERSION="v$PIXI_VERSION" PIXI_BIN_DIR=/usr/local/bin \
        PIXI_NO_PATH_UPDATE=1 bash

USER user
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
    | sh -s -- -y --profile minimal

RUN pixi global install --environment cli-utils \
    --expose fd --expose python --expose python3=python \
    --expose rg --expose ruff \
    "fd-find=$FD_VERSION" matplotlib numpy pandas "python=$PYTHON_VERSION" \
    scikit-learn scipy seaborn \
    "ripgrep=$RIPGREP_VERSION" "ruff=$RUFF_VERSION"

USER root
ENV PNPM_HOME=/usr/local/share/pnpm \
    PATH=/usr/local/share/pnpm/bin:$PATH

# npm only bootstraps pnpm; third-party CLIs are installed by pnpm without
# lifecycle scripts.
RUN npm install --global --ignore-scripts "pnpm@$PNPM_VERSION" \
    && rm -rf /root/.npm

RUN HOME=/root pnpm \
    add --global --ignore-scripts "playwright@$PLAYWRIGHT_VERSION"

# Keep frequently updated agents late and refresh them on every image build.
ARG AGENT_CACHE_BUST
RUN : "$AGENT_CACHE_BUST" \
    && HOME=/root pnpm \
        add --global --ignore-scripts \
            "@earendil-works/pi-coding-agent" \
            "firecrawl-cli@$FIRECRAWL_VERSION" \
    && PATH="$(npm root --global)/npm/bin/node-gyp-bin:$PATH" \
        HOME=/root pnpm \
        add --global --allow-build=node-pty "t3@$T3_VERSION"

RUN curl -fsSL https://chatgpt.com/codex/install.sh \
    | env CODEX_HOME=/opt/codex CODEX_INSTALL_DIR=/usr/local/bin \
        CODEX_NON_INTERACTIVE=1 sh

COPY --chmod=755 commit-msg-hook /usr/local/share/git-hooks/commit-msg
RUN git config --system core.hooksPath /usr/local/share/git-hooks

USER user
RUN curl -fsSL https://claude.ai/install.sh | bash

COPY --chown=user:user container-entrypoint /usr/local/bin/container-entrypoint
ENTRYPOINT ["/usr/local/bin/container-entrypoint"]
CMD ["bash"]
