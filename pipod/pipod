#!/bin/bash

set -euo pipefail

IMAGE="localhost/pipod:latest"
run_args=()
gpu=false
stage_dirs_arg=""
stage_dirs_set=false

usage() {
    >&2 echo "Usage: $(basename "$0") [--gpu] [--stage-dirs DIRS] [--image IMAGE] [-- COMMAND ...]"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    --gpu)
        gpu=true
        shift
        ;;
    --stage-dirs)
        [[ $# -ge 2 ]] || { usage; exit 1; }
        stage_dirs_arg="$2"
        stage_dirs_set=true
        shift 2
        ;;
    --image)
        [[ $# -ge 2 ]] || { usage; exit 1; }
        IMAGE="$2"
        shift 2
        ;;
    --)
        shift
        run_args+=("$@")
        break
        ;;
    *)
        run_args+=("$1")
        shift
        ;;
    esac
done

command -v podman >/dev/null || {
    >&2 echo "ERROR: podman not found"
    exit 1
}

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT INT TERM HUP

podman_args=(
    run --rm --interactive --pull=missing --pids-limit=-1
    "--userns=keep-id:uid=1001,gid=1001" --user=user
    --security-opt label=disable
    --env EDITOR=vim
    --env DISABLE_AUTOUPDATER=1
    --env PNPM_CONFIG_IGNORE_SCRIPTS=true
)
[[ -t 1 ]] && podman_args+=(--tty)

mounts=()
if [[ "$gpu" == true ]]; then
    gpu_devices=(/dev/nvidia[0-9]* /dev/nvidiactl /dev/nvidia-uvm \
        /dev/nvidia-uvm-tools /dev/nvidia-caps/*)
    existing_gpu_devices=()
    for device in "${gpu_devices[@]}"; do
        [[ -e "$device" ]] && existing_gpu_devices+=("$device")
    done
    [[ ${#existing_gpu_devices[@]} -gt 0 ]] || {
        >&2 echo "ERROR: no NVIDIA devices found"
        exit 1
    }

    driver_library=$(ldconfig -p | awk '$1 == "libcuda.so.1" { print $NF; exit }')
    [[ -n "$driver_library" ]] || {
        >&2 echo "ERROR: libcuda.so.1 not found"
        exit 1
    }
    driver_dir=$(dirname "$(realpath "$driver_library")")

    podman_args+=(--group-add keep-groups)
    for device in "${existing_gpu_devices[@]}"; do
        podman_args+=(--device "$device")
    done
    mounts+=(--volume "$driver_dir:/usr/local/lib/pipod-nvidia:ro")
    podman_args+=(--env LD_LIBRARY_PATH=/usr/local/lib/pipod-nvidia)
    if [[ -x /usr/bin/nvidia-smi ]]; then
        mounts+=(--volume /usr/bin/nvidia-smi:/usr/bin/nvidia-smi:ro)
    fi
fi
mount_if_present() {
    local source="$1"
    local destination="$2"
    local mode="${3:-}"
    [[ -e "$source" || -L "$source" ]] || return 0
    mounts+=(--volume "$source:$destination$mode")
}

# Agent configuration and state. Agent executables are installed in the image.
mount_if_present "$HOME/.claude" /home/user/.claude
mount_if_present "$HOME/.claude.json" /home/user/.claude.json
mount_if_present "$HOME/.local/state/claude" /home/user/.local/state/claude
mount_if_present "$HOME/.codex" /home/user/.codex
mount_if_present "$HOME/.pi" /home/user/.pi
# pnpm must use the store that ~/.pi/agent/npm/node_modules was linked from.
pnpm_store="$HOME/.local/share/pnpm/store"
mount_if_present "$pnpm_store" /home/user/.local/share/pnpm/store
if [[ -d "$pnpm_store" ]]; then
    podman_args+=(
        --env PNPM_CONFIG_STORE_DIR=/home/user/.local/share/pnpm/store
    )
fi
mount_if_present "$HOME/agent-memory" /home/user/agent-memory
mkdir -p "$HOME/.config"
install -d -m 700 "$HOME/.config/firecrawl-cli"
mount_if_present "$HOME/.config/firecrawl-cli" \
    /home/user/.config/firecrawl-cli
mount_if_present "$HOME/.cache" /home/user/.cache
mount_if_present "$HOME/.gitconfig" /home/user/.gitconfig :ro

in_array() {
    local -n array="$1"
    local value="$2"
    local item
    for item in "${array[@]}"; do
        [[ "$item" == "$value" ]] && return 0
    done
    return 1
}

# Preserve top-level relative links in each agent directory without exposing the
# host target path. The mount destination is derived from the link as seen inside.
agent_roots=("$HOME/.claude" "$HOME/.codex" "$HOME/.pi/agent")
for root in "${agent_roots[@]}"; do
    [[ -d "$root" ]] || continue
    while IFS= read -r link; do
        target=$(readlink -f "$link") || target=""
        if [[ -z "$target" || ! -e "$target" ]]; then
            >&2 echo "ERROR: dangling or broken symlink '$link'"
            exit 1
        fi

        target_raw=$(readlink "$link")
        if [[ "$target_raw" == /* ]]; then
            >&2 echo "WARNING: absolute symlink '$link' exposes '$target' in the container"
            bind_target="$target"
        else
            container_link="/home/user${link#"$HOME"}"
            bind_target=$(realpath -m "$(dirname "$container_link")/$target_raw")
        fi

        mount="$target:$bind_target"
        if ! in_array mounts "$mount"; then
            mounts+=(--volume "$mount")
        fi
    done < <(find "$root" -maxdepth 1 -type l)
done

if [[ "$stage_dirs_set" == true ]]; then
    if [[ -z "$stage_dirs_arg" || "$stage_dirs_arg" == *, || \
        "$stage_dirs_arg" == ,* || "$stage_dirs_arg" == *,,* ]]; then
        >&2 echo "ERROR: empty entry in --stage-dirs"
        exit 1
    fi
    IFS=',' read -r -a raw_stage_dirs <<<"$stage_dirs_arg"
else
    raw_stage_dirs=("$PWD")
fi

stage_dirs=()
stage_dir_modes=()
for raw_stage_dir in "${raw_stage_dirs[@]}"; do
    stage_dir_mode=""
    if [[ "$stage_dirs_set" == true && "$raw_stage_dir" == *:ro ]]; then
        raw_stage_dir=${raw_stage_dir%:ro}
        stage_dir_mode=":ro"
    fi
    if [[ "$stage_dirs_set" == true && "$raw_stage_dir" != /* ]]; then
        >&2 echo "ERROR: --stage-dirs entries must be absolute paths: '$raw_stage_dir'"
        exit 1
    fi
    if [[ ! -d "$raw_stage_dir" ]]; then
        >&2 echo "ERROR: --stage-dirs entry is not a directory: '$raw_stage_dir'"
        exit 1
    fi
    stage_dirs+=("$raw_stage_dir")
    stage_dir_modes+=("$stage_dir_mode")
done

container_pwd=/work
stage_dir() {
    local host_dir="$1"
    local bind_mode="$2"
    local work_dir_name work_dir_hash masked_work_dir

    work_dir_name=$(basename "$host_dir")
    work_dir_hash=$(printf %s "$host_dir" | sha256sum | cut -c1-12)
    masked_work_dir="/work/$work_dir_hash/$work_dir_name"
    [[ "$stage_dirs_set" == true ]] || container_pwd="$masked_work_dir"
    mounts+=(--volume "$host_dir:$masked_work_dir$bind_mode")

    if [[ -f "$host_dir/pixi.toml" && -z "$bind_mode" ]]; then
        if [[ ! -d "$host_dir/.pixi-containers" ]]; then
            >&2 echo "INFO: Creating container pixi directory at '$host_dir/.pixi-containers'"
            mkdir -p "$host_dir/.pixi-containers"
        fi
        mounts+=(--volume "$host_dir/.pixi-containers:$masked_work_dir/.pixi")
    fi

    if [[ -f "$host_dir/.git" ]]; then
        gitdir_line=$(head -n 1 "$host_dir/.git" || true)
        if [[ "$gitdir_line" == gitdir:* ]]; then
            gitdir_path=${gitdir_line#gitdir: }
            if [[ "$gitdir_path" == /* ]]; then
                abs_gitdir_path="$gitdir_path"
            else
                abs_gitdir_path=$(realpath "$host_dir/$gitdir_path")
            fi

            worktree_name=$(basename "$abs_gitdir_path")
            if [[ "$abs_gitdir_path" != */.git/worktrees/"$worktree_name" ]]; then
                >&2 echo "ERROR: unexpected gitdir path format: $gitdir_path"
                exit 1
            fi
            main_git_dir=${abs_gitdir_path%%/.git/*}/.git
            if [[ "$stage_dirs_set" == true ]]; then
                container_git_dir="/main-worktrees/$work_dir_hash/.git"
            else
                container_git_dir=/main-worktree/.git
            fi
            container_gitdir_path="$container_git_dir/worktrees/$worktree_name"
            tmp_gitfile="$tmp_dir/dotgit-$work_dir_hash"
            echo "gitdir: $container_gitdir_path" >"$tmp_gitfile"
            mounts+=(
                --volume "$main_git_dir:$container_git_dir$bind_mode"
                --volume "$tmp_gitfile:$masked_work_dir/.git:ro"
            )
        fi
    fi
}

for i in "${!stage_dirs[@]}"; do
    stage_dir "${stage_dirs[$i]}" "${stage_dir_modes[$i]}"
done

podman_args+=(--workdir "$container_pwd")
[[ ${#run_args[@]} -gt 0 ]] || run_args=(bash)
if [[ "${run_args[0]}" == pi ]]; then
    run_args=(
        pi --model openai-codex/gpt-5.6-sol --thinking medium
        "${run_args[@]:1}"
    )
fi
exec podman "${podman_args[@]}" "${mounts[@]}" "$IMAGE" "${run_args[@]}"
