#!/bin/bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
pipod="$script_dir/../pipod/pipod"
usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] PROJECT_DIR [PROJECT_DIR ...]

Options:
  -h, --help    Show this help message
  --debug       Start a shell instead of T3 Code
  --remote-img  Use docker.io/julibeg/pipod:latest
EOF
}

debug=false
pipod_args=(--flat-stage-dirs)
while [[ "${1:-}" == -* ]]; do
    case "$1" in
    -h|--help) usage; exit 0 ;;
    --debug) debug=true ;;
    --remote-img) pipod_args+=(--remote-img) ;;
    *) break ;;
    esac
    shift
done

if [[ $# -eq 0 ]]; then
    usage >&2
    exit 1
fi

project_dirs=()
for project_dir in "$@"; do
    project_dir=$(realpath "$project_dir")
    [[ -d "$project_dir" ]] || {
        echo "Error: $project_dir is not a directory" >&2
        exit 1
    }
    project_dirs+=("$project_dir")
done

if [[ ${#project_dirs[@]} -eq 1 ]]; then
    cd "${project_dirs[0]}"
else
    stage_dirs=$(IFS=,; echo "${project_dirs[*]}")
    pipod_args+=(--stage-dirs "$stage_dirs")
fi

if [[ "$debug" == true ]]; then
    exec "$pipod" "${pipod_args[@]}" bash
fi

exec "$pipod" "${pipod_args[@]}" \
    --publish 127.0.0.1:3773:3773 -- \
    t3 --no-browser --host 0.0.0.0 --port 3773
