ARG PLAYWRIGHT_VERSION
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/uv-project-environment

COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /usr/local/bin/uv

RUN install -d /opt/uv-project-environment \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential ca-certificates curl jq \
    && rm -rf /var/lib/apt/lists/*

ARG PLAYWRIGHT_VERSION
RUN npm install --global "playwright@$PLAYWRIGHT_VERSION" \
    && npm cache clean --force

ARG T3_VERSION
RUN npm install --global "t3@$T3_VERSION" \
    && npm cache clean --force

ARG AGENT_CACHE_BUST
RUN : "$AGENT_CACHE_BUST" \
    && curl -fsSL https://chatgpt.com/codex/install.sh -o /tmp/install-codex.sh \
    && env CODEX_HOME=/opt/codex CODEX_INSTALL_DIR=/usr/local/bin \
        CODEX_NON_INTERACTIVE=1 sh /tmp/install-codex.sh \
    && rm /tmp/install-codex.sh \
    && test -x /usr/local/bin/codex

COPY build-tmp/pixi-build /usr/local/bin/pixi
COPY container-entrypoint /usr/local/bin/t3pod-entrypoint
